__pycache__/
*.py[cod]
# Analysis inputs and complete per-run outputs stay local/server-side.
**/data/
**/result/
# Keep input data local at the repository root and inside analysis modules.
data/
results_all/
# Ignore generated results in every analysis module, including archived outputs.
results/
